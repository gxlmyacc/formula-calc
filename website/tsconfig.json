{
  "compilerOptions": {
    "target": "ES2020", "lib": ["DOM", "ES2020"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react", "strict": true, "noImplicitThis": false, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["vite/client"], "allowImportingTsExtensions": true, "resolveJsonModule": true
  },
  "include": ["src", "vite.config.mts"]
}
