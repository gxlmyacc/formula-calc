{
  "name": "formula-calc",
  "version": "0.2.8",
  "description": "formula-calc is a library for formula calculation through strings for javascript.",
  "keywords": [
    "formula",
    "formula-calc",
    "formula-calculator",
    "formula-calculation",
    "formula-calculate",
    "decimal",
    "decimal-calc",
    "decimal-calculator",
    "decimal-calculation",
    "decimal-calculate",
    "calc",
    "calculator",
    "calculation",
    "calculate",
    "string-calc",
    "string-calculator",
    "string-calculation",
    "string-calculate",
    "string-formula",
    "string-formula-calc",
    "string-formula-calculator",
    "string-formula-calculation",
    "string-formula-calculate"
  ],
  "sideEffects": false,
  "main": "esm/index.js",
  "module": "esm/index.js",
  "typings": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.js",
      "default": "./esm/index.js"
    },
    "./es": {
      "types": "./types/index.d.ts",
      "import": "./es/index.js",
      "default": "./es/index.js"
    },
    "./esm": {
      "types": "./types/index.d.ts",
      "import": "./esm/index.js",
      "default": "./esm/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "engines": {
    "node": "> 12"
  },
  "files": [
    "esm",
    "es",
    "src",
    "types"
  ],
  "scripts": {
    "test": "npm run typecheck && jest",
    "test:demo": "jest -- tests/demo.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:build": "npm run build && node scripts/check-build.js",
    "coverage": "npm run typecheck && jest --coverage",
    "build": "npm run build:types && npm run build:js && npm run build:es",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "cross-env BUILD_ENV=js babel src -d esm --extensions \".ts,.tsx\" --source-maps",
    "build:es": "cross-env BUILD_ENV=es babel src -d es --extensions \".ts,.tsx\"",
    "prepare": "npm run build",
    "dev:website": "vite --config website/vite.config.mts",
    "preview:website": "vite preview --config website/vite.config.mts",
    "typecheck:website": "tsc -p website/tsconfig.json",
    "build:website": "npm run typecheck:website && vite build --config website/vite.config.mts",
    "test:website": "jest --config website/jest.config.cjs",
    "check:website": "node scripts/check-website.js",
    "lint": "eslint src tests website/src --ext .ts,.tsx"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gxlmyacc/formula-calc"
  },
  "author": "gxlmyacc",
  "dependencies": {
    "core-js": "^3.0.0",
    "decimal.js": "^10.4.3",
    "tslib": "^2.0.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@jest/globals": "^29.7.0",
    "@types/codemirror": "^5.60.18",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/react": "16",
    "@types/react-dom": "16",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-legacy": "7",
    "acorn": "8",
    "antd": "3.26.20",
    "babel-plugin-define-variables": "^0.0.3",
    "babel-preset-react-scope-style": "0.1.0",
    "classnames": "2",
    "codemirror": "5.65.21",
    "coveralls": "^3.1.1",
    "cross-env": "^7.0.3",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "jest": "^29.7.0",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "sass": "1.93.2",
    "terser": "5",
    "ts-jest": "29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "7"
  }
}
